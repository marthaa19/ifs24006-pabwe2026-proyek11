{
  "name": "lombaradar-backend",
  "version": "1.0.0",
  "description": "API LombaRadar - Express.js + SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "seed": "node seed.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:ci": "node -e \"require('fs').mkdirSync('test-results',{recursive:true})\" && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/junit.xml \"tests/*.test.js\""
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1"
  }
}
